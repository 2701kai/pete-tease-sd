# Prodigi. Use the sandbox host until a real print comes back correct.
PRODIGI_API_KEY=
PRODIGI_BASE_URL=https://api.sandbox.prodigi.com/v4.0

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Where the print-resolution masters live. Never in /public, never in git.
BLOB_READ_WRITE_TOKEN=
MASTER_URL_TTL_SECONDS=1800

# Absolute origin, no trailing slash. Stripe redirects here after payment and
# fetches the line item image from it. On Vercel this is optional: the
# deployment's own URL is used when it is unset, so previews redirect back to
# themselves. Set it to the canonical domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
